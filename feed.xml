---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0">
<channel>
<title>{{ site.title | xml_escape }}</title>
<link>{{ site.url }}{{ site.baseurl }}/</link>
<description>أحدث النصوص المنشورة في منصة حدوش للأدب والثقافة</description>
<language>ar</language>
{% assign feed_articles = site.articles | sort: "date" | reverse %}
{% for a in feed_articles limit:20 %}
{% if a.published != false %}
<item>
<title>{{ a.title | xml_escape }}</title>
<link>{{ site.url }}{{ site.baseurl }}{{ a.url }}</link>
<guid>{{ site.url }}{{ site.baseurl }}{{ a.url }}</guid>
<pubDate>{{ a.date | date_to_rfc822 }}</pubDate>
<description>{{ a.excerpt | default: a.content | strip_html | truncate: 320 | xml_escape }}</description>
</item>
{% endif %}
{% endfor %}
</channel>
</rss>
