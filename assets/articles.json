---
---
[
{% for a in site.articles reversed %}
  {
    "title": {{ a.title | jsonify }},
    "slug": {{ a.slug | default: a.basename_without_ext | jsonify }},
    "excerpt": {{ a.excerpt | default: "" | strip_html | jsonify }},
    "author": {{ a.author | default: "" | jsonify }},
    "country": {{ a.country | default: "" | jsonify }},
    "category": {{ a.category | default: "" | jsonify }},
    "genres": [
      {% case a.category %}
        {% when "الشعر" %}"poetry"
        {% when "القصة القصيرة" %}"short-story"
        {% when "الرواية" %}"novel"
        {% when "المقال الأدبي" %}"literary-article"
        {% when "النقد الأدبي" %}"literary-criticism"
        {% when "الفكر والتأمل" %}"thought"
        {% when "الثقافة" %}"culture"
        {% else %}"other"
      {% endcase %}
    ],
    "series": {{ a.series | default: "" | jsonify }},
    "featured": {{ a.featured | default: false | jsonify }},
    "tags": {{ a.tags | default: empty | jsonify }},
    "date": {{ a.date | date: "%Y-%m-%d" | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]