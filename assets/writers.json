---
---
[
{% for w in site.writers %}
  {
    "name": {{ w.name | jsonify }},
    "slug": {{ w.slug | default: w.basename_without_ext | jsonify }},
    "country": {{ w.country | default: "" | jsonify }},
    "city": {{ w.city | default: "" | jsonify }},
    "role": {{ w.role | default: "كاتب" | jsonify }},
    "bio": {{ w.bio | default: "" | jsonify }},
    "topics": {{ w.topics | default: empty | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]